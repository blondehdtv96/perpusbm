# Environment and local secrets
**/.env
**/.env.*
!**/.env.example
**/*.local
/backend/auth.json

# Dependencies
/backend/vendor/
/backend/node_modules/
/frontend/node_modules/

# Build output
/backend/public/build/
/backend/public/hot
/backend/public/storage
/frontend/dist/
/frontend/dist-ssr/

# Laravel runtime and local data
/backend/bootstrap/cache/*
!/backend/bootstrap/cache/.gitignore
/backend/database/*.sqlite*
/backend/storage/*.key
/backend/storage/pail/
/backend/.phpunit.cache/
/backend/.phpunit.result.cache
/backend/coverage/
/frontend/coverage/

# Logs and package-manager diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE and editor settings
.vscode/
.idea/
.fleet/
.zed/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating-system and temporary files
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.temp
*.bak
*.orig
~$*